[Unit]
Description=Watch GitHub reachability and keep the steadiest DNS
After=network-online.target systemd-resolved.service
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 /usr/local/bin/dns-github-watch.py run
SyslogIdentifier=dns-github-watch
Restart=always
RestartSec=5
Nice=10

[Install]
WantedBy=multi-user.target
