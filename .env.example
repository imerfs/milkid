# Copy to .env and fill in. Never commit .env.
DJANGO_SECRET_KEY=change-me-generate-a-long-random-string
DEBUG=False
REPLIT_DOMAINS=localhost,127.0.0.1
USE_POSTGRES=False
PGDATABASE=
PGUSER=
PGPASSWORD=
PGHOST=
PGPORT=5432
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=0
MAX_FILE_SIZE=10485760
# Outgoing email (SMTP), e.g. a mailbox at your mail provider. Leave EMAIL_HOST empty to keep localhost:25.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=
# Incoming mail for the admin mailbox (optional; "Fetch from server" button). Leave IMAP_HOST empty to disable.
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
# Copy of support-form messages is also emailed here (optional).
SITE_EMAIL=
