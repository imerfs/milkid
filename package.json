{
  "name": "melkid-frontend",
  "private": true,
  "description": "Builds static/css/tailwind.css (replaces the Tailwind CDN script).",
  "scripts": {
    "build:css": "tailwindcss -c tailwind.config.js -i static/src/tailwind.input.css -o static/css/tailwind.css --minify"
  },
  "devDependencies": {
    "@fortawesome/fontawesome-free": "6.4.0",
    "bootstrap": "5.3.0",
    "chart.js": "4.5.1",
    "htmx.org": "2.0.11",
    "leaflet": "1.9.4",
    "material-icons": "1.13.14",
    "sortablejs": "1.15.7",
    "tailwindcss": "3.4.17",
    "vazirmatn": "33.0.3"
  }
}
