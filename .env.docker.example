# Copy to .env (never commit it). Used by docker-compose.yml.
DJANGO_SECRET_KEY=change-me-generate-a-long-random-string
DEBUG=False
# the server's IP or domain (comma separated); also the allowed host names
REPLIT_DOMAINS=88.218.18.165
# over plain HTTP set False; behind HTTPS set True
COOKIE_SECURE=False
SECURE_SSL_REDIRECT=False

PGDATABASE=melkid
PGUSER=melkid
